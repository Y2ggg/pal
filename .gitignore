.DS_Store
**/.DS_Store

# Disposable POC runtime state; evidence and fixtures remain tracked.
.poc-work/
poc/.runtime/

# Python cache generated by POC validators.
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
build/
dist/
*.egg-info/

# Local browser runtime screenshots and profiles.
.playwright-mcp/

# Local credentials and private review material.
.env
.env.*
!.env.example
*.pem
*.key
.private-review/
